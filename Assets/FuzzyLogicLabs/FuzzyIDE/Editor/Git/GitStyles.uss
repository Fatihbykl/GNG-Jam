/* ============================================================
   Git Window Stylesheet — FuzzyIDE
   GitHub Desktop kalitesinde görsel tasarım
   ============================================================ */

/* ── Root ─────────────────────────────────────────────────── */
.git-root {
    flex-grow: 1;
    height: 100%;
    background-color: #1e1e1e;
    color: #cccccc;
    font-size: 12px;
    position: relative;
    overflow: hidden;
}

/* ── Top Bar (GitHub Desktop 3-Segment Toolbar) ───────────── */
.git-top-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 48px;
    background-color: #252526;
    border-bottom-width: 1px;
    border-bottom-color: #333333;
    padding-left: 8px;
    padding-right: 8px;
}

.git-topbar-left {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.git-topbar-segment {
    flex-direction: column;
    justify-content: center;
    height: 36px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: #2b2b2b;
    border-radius: 6px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #3c3c3c;
    margin-right: 8px;
    cursor: link;
}

.git-topbar-segment:hover {
    background-color: #353535;
    border-color: #505050;
}

.git-topbar-segment-active {
    background-color: #173852;
    border-color: #0e639c;
}

.git-topbar-segment-caption {
    font-size: 9px;
    color: #888888;
    margin-bottom: 2px;
}

.git-topbar-segment-row {
    flex-direction: row;
    align-items: center;
}

.git-topbar-segment-icon {
    font-size: 11px;
    color: #cccccc;
    margin-right: 5px;
}

.git-topbar-segment-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: #ffffff;
    max-width: 220px;
    -unity-text-overflow-position: end;
    overflow: hidden;
    white-space: nowrap;
}

.git-topbar-segment-arrow {
    font-size: 10px;
    color: #aaaaaa;
    margin-left: 6px;
}

/* Sync action button */
.git-topbar-sync-btn {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: 36px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: #323232;
    border-radius: 6px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #444444;
    cursor: link;
}

.git-topbar-sync-btn:hover {
    background-color: #3d3d3d;
    border-color: #606060;
}

.git-topbar-sync-btn-highlight {
    background-color: #0e639c;
    border-color: #1177bb;
}

.git-topbar-sync-btn-highlight:hover {
    background-color: #1177bb;
    border-color: #1c88cf;
}

.git-topbar-sync-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: #ffffff;
}

.git-topbar-sync-subtitle {
    font-size: 9px;
    color: #999999;
    margin-top: 1px;
}

.git-toolbar-btn-icon {
    width: 36px;
    height: 36px;
    background-color: #2b2b2b;
    border-radius: 6px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #3c3c3c;
    margin-left: 6px;
    cursor: link;
    align-items: center;
    justify-content: center;
}

.git-toolbar-btn-icon:hover {
    background-color: #353535;
    border-color: #505050;
}

/* ── Branch Popover (Dropdown Dialog) ─────────────────────── */
.git-popover-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.35);
}

.git-branch-popover {
    position: absolute;
    top: 48px;
    left: 160px;
    width: 380px;
    max-height: 480px;
    background-color: #252526;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #454545;
    border-radius: 8px;
    flex-direction: column;
    overflow: hidden;
}

.git-popover-tabs {
    flex-direction: row;
    height: 32px;
    background-color: #1f1f1f;
    border-bottom-width: 1px;
    border-bottom-color: #333333;
}

.git-popover-tab {
    flex-grow: 1;
    height: 100%;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    color: #888888;
    background-color: transparent;
    border-top-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    cursor: link;
}

.git-popover-tab:hover {
    color: #cccccc;
    background-color: #272727;
}

.git-popover-tab-active {
    color: #ffffff;
    -unity-font-style: bold;
    border-bottom-color: #007acc;
    background-color: #252526;
}

.git-popover-toolbar {
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #303030;
}

.git-popover-search-box {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    height: 26px;
    background-color: #1a1a1a;
    border-radius: 4px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #3a3a3a;
    padding-left: 6px;
    padding-right: 6px;
    margin-right: 6px;
}

.git-popover-search-input {
    flex-grow: 1;
    font-size: 11px;
    background-color: transparent;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    color: #cccccc;
    padding-left: 4px;
    padding-right: 4px;
}

.git-popover-new-btn {
    height: 26px;
    padding-left: 10px;
    padding-right: 10px;
    font-size: 11px;
    -unity-font-style: bold;
    background-color: #0e639c;
    color: #ffffff;
    border-radius: 4px;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    cursor: link;
}

.git-popover-new-btn:hover {
    background-color: #1177bb;
}

.git-popover-new-drawer {
    background-color: #1c1c1c;
    padding: 10px;
    border-bottom-width: 1px;
    border-bottom-color: #333333;
}

.git-popover-drawer-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: #cccccc;
    margin-bottom: 6px;
}

.git-popover-drawer-input {
    height: 26px;
    font-size: 11px;
    background-color: #2a2a2a;
    border-radius: 4px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #444444;
    color: #ffffff;
    margin-bottom: 6px;
}

.git-popover-drawer-hint {
    font-size: 10px;
    color: #777777;
    margin-bottom: 8px;
}

/* Prompt overlay (text input dialog) */
.git-prompt-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.45);
    align-items: center;
    justify-content: center;
}

.git-prompt-box {
    width: 420px;
    max-width: 90%;
    padding: 14px 16px;
    background-color: #252526;
    border-width: 1px;
    border-color: #454545;
    border-radius: 8px;
}

.git-prompt-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: #E0E0E0;
    margin-bottom: 6px;
}

.git-prompt-message {
    white-space: normal;
    font-size: 11px;
    color: #9A9A9A;
    margin-bottom: 10px;
}

.git-prompt-input {
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 6px;
}

.git-prompt-input > Label {
    min-width: 44px;
    color: #AAAAAA;
}

.git-prompt-error {
    font-size: 11px;
    color: #f85149;
    margin-bottom: 6px;
    white-space: normal;
}

/* Merge / rebase in progress */
.git-operation-banner {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    background-color: rgba(210, 153, 34, 0.15);
    border-bottom-width: 1px;
    border-bottom-color: #d29922;
}

.git-operation-label {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    font-size: 12px;
    color: #e3c27a;
}

.git-operation-banner > Button {
    margin-left: 6px;
}

.git-toast-action {
    margin-top: 6px;
    margin-left: 0;
    align-self: flex-start;
    font-size: 11px;
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.15);
    border-width: 0;
    border-radius: 4px;
    padding: 2px 10px;
}

.git-toast-action:hover {
    background-color: rgba(255, 255, 255, 0.28);
}

.git-section-conflicts .git-section-title {
    color: #F07070;
}

.git-popover-drawer-toggle {
    font-size: 11px;
    margin-left: 0;
    margin-bottom: 8px;
}

.git-popover-drawer-toggle > Label {
    min-width: 0;
    flex-grow: 1;
    color: #AAAAAA;
}

.git-popover-drawer-actions {
    flex-direction: row;
    justify-content: flex-end;
}

.git-popover-group-label {
    font-size: 10px;
    -unity-font-style: bold;
    color: #777777;
    padding-left: 10px;
    padding-top: 8px;
    padding-bottom: 4px;
}

.git-popover-item {
    flex-direction: row;
    align-items: center;
    height: 30px;
    padding-left: 10px;
    padding-right: 8px;
    cursor: link;
    border-left-width: 3px;
    border-left-color: transparent;
}

.git-popover-item:hover {
    background-color: #2a2d2e;
    border-left-color: #007acc;
}

.git-popover-item-current {
    background-color: #12283a;
}

.git-popover-item-icon {
    font-size: 12px;
    color: #888888;
    width: 16px;
    margin-right: 6px;
    -unity-text-align: middle-center;
}

.git-popover-item-name {
    font-size: 11px;
    color: #cccccc;
    flex-grow: 1;
    -unity-text-overflow-position: end;
    overflow: hidden;
    white-space: nowrap;
}

.git-popover-item-current-badge {
    font-size: 11px;
    color: #4ec9b0;
    -unity-font-style: bold;
    margin-right: 4px;
}

.git-popover-item-del-btn {
    width: 20px;
    height: 20px;
    font-size: 11px;
    color: #666666;
    background-color: transparent;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    cursor: link;
    border-radius: 3px;
    align-items: center;
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.git-popover-item-del-btn:hover {
    color: #f85149;
    background-color: #4a1a1a;
}

.git-popover-item-del-btn-suggested {
    color: #d29922;
}

.git-popover-drawer-hint-error {
    color: #f85149;
}

.git-popover-drawer-base {
    margin-left: 0;
    margin-bottom: 8px;
    font-size: 11px;
}

.git-popover-drawer-base > Label {
    min-width: 60px;
    color: #AAAAAA;
}

.git-popover-detached {
    margin: 8px 10px;
    padding: 8px 10px;
    border-radius: 4px;
    background-color: rgba(210, 153, 34, 0.12);
    border-left-width: 3px;
    border-left-color: #d29922;
    align-items: flex-start;
}

.git-popover-detached-label {
    white-space: normal;
    font-size: 11px;
    color: #d8c08a;
    margin-bottom: 6px;
}

/* Pull Requests View */
.git-pr-container {
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 24px;
    padding-bottom: 24px;
    align-items: center;
    justify-content: center;
}

.git-pr-icon {
    font-size: 28px;
    color: #8957e5;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.git-pr-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: #ffffff;
    margin-bottom: 4px;
    -unity-text-align: middle-center;
}

.git-pr-subtitle {
    font-size: 11px;
    color: #888888;
    margin-bottom: 16px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.git-pr-create-btn {
    height: 32px;
    padding-left: 18px;
    padding-right: 18px;
    font-size: 12px;
    -unity-font-style: bold;
    background-color: #238636;
    color: #ffffff;
    border-radius: 6px;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    cursor: link;
    margin-bottom: 10px;
}

.git-pr-create-btn:hover {
    background-color: #2ea043;
}

.git-pr-link-btn {
    font-size: 11px;
    color: #58a6ff;
    background-color: transparent;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    cursor: link;
}

.git-pr-link-btn:hover {
    color: #79b8ff;
}


/* ── Navigation Tabs ──────────────────────────────────────── */
.git-nav-tabs {
    flex-direction: row;
    height: 34px;
    background-color: #2d2d2d;
    border-bottom-width: 1px;
    border-bottom-color: #383838;
    padding-left: 4px;
}

.git-nav-tab {
    padding-left: 16px;
    padding-right: 16px;
    height: 100%;
    align-items: center;
    justify-content: center;
    color: #969696;
    font-size: 12px;
    -unity-font-style: normal;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    background-color: transparent;
    cursor: link;
    margin-right: 2px;
}

.git-nav-tab:hover {
    color: #e0e0e0;
    background-color: #363636;
}

.git-nav-tab-active {
    color: #ffffff;
    border-bottom-color: #007acc;
    background-color: #1e1e1e;
    -unity-font-style: bold;
}

/* ── File Lists & Section Headers ─────────────────────────── */
.git-section-container {
    margin-bottom: 2px;
}

.git-section-header {
    flex-direction: row;
    align-items: center;
    background-color: #252526;
    padding-left: 8px;
    padding-right: 6px;
    height: 28px;
    border-bottom-width: 1px;
    border-bottom-color: #2e2e2e;
    cursor: link;
}

.git-section-header:hover {
    background-color: #2d2d30;
}

.git-section-chevron {
    font-size: 10px;
    color: #888888;
    margin-right: 6px;
    width: 12px;
    -unity-text-align: middle-center;
}

.git-section-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: #aaaaaa;
}

.git-section-badge {
    font-size: 10px;
    -unity-font-style: bold;
    color: #888888;
    background-color: #333333;
    border-radius: 9px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 1px;
    padding-bottom: 1px;
    margin-left: 6px;
}

.git-section-actions {
    flex-direction: row;
    align-items: center;
    margin-left: auto;
}

.git-section-action-btn {
    width: 22px;
    height: 22px;
    font-size: 12px;
    -unity-font-style: bold;
    background-color: transparent;
    color: #888888;
    border-radius: 3px;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 2px;
    cursor: link;
    align-items: center;
    justify-content: center;
}

.git-section-action-btn:hover {
    color: #ffffff;
    background-color: #3e3e42;
}

.git-section-action-btn-danger:hover {
    color: #f85149;
    background-color: #4a1a1a;
}


/* ── File Row (Enhanced) ──────────────────────────────────── */
.git-file-row {
    flex-direction: row;
    align-items: center;
    min-height: 32px;
    padding-left: 8px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #242424;
    border-left-width: 3px;
    border-left-color: transparent;
    cursor: link;
}

.git-file-row:hover {
    background-color: #2a2d2e;
    border-left-color: #4a4a4a;
}

.git-file-row-selected {
    background-color: #094771;
    border-left-color: #007acc;
}

.git-file-row-selected:hover {
    background-color: #0a5280;
    border-left-color: #007acc;
}


/* Row actions: hidden by default, show on hover */
.git-row-actions {
    display: none;
    flex-direction: row;
    align-items: center;
    margin-left: 4px;
}

.git-file-row:hover .git-row-actions {
    display: flex;
}

.git-file-row-selected .git-row-actions {
    display: flex;
}

.git-row-action-btn {
    width: 22px;
    height: 22px;
    font-size: 12px;
    background-color: transparent;
    border-radius: 3px;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    color: #888888;
    align-items: center;
    justify-content: center;
    cursor: link;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 2px;
}

.git-row-action-btn:hover {
    background-color: #3d3d3d;
    color: #cccccc;
}

.git-row-action-btn-danger:hover {
    background-color: #4a1a1a;
    color: #f97583;
}

/* File info column */
.git-file-info-col {
    flex-grow: 1;
    justify-content: center;
    margin-left: 6px;
    margin-right: 6px;
    overflow: hidden;
}

.git-file-name {
    color: #e0e0e0;
    font-size: 12px;
    -unity-text-overflow-position: end;
    overflow: hidden;
}

.git-file-path {
    color: #666666;
    font-size: 10px;
    -unity-text-overflow-position: end;
    overflow: hidden;
    margin-top: 1px;
}

/* Status Badges */
.git-badge {
    border-radius: 3px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 2px;
    padding-bottom: 2px;
    font-size: 10px;
    -unity-font-style: bold;
    color: #ffffff;
    min-width: 16px;
    -unity-text-align: middle-center;
}

.git-badge-modified  { background-color: #cca700; color: #1e1e1e; }
.git-badge-added     { background-color: #28a745; }
.git-badge-untracked { background-color: #28a745; }
.git-badge-deleted   { background-color: #d73a49; }
.git-badge-renamed   { background-color: #007acc; }
.git-badge-conflict  { background-color: #e05252; }

/* ── Commit Box ───────────────────────────────────────────── */
.git-commit-box {
    background-color: #1a1a1a;
    border-top-width: 1px;
    border-top-color: #333333;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    flex-shrink: 0;
    flex-grow: 0;
}

.git-commit-message-scroll {
    min-height: 52px;
    height: 64px;
    max-height: 84px;
    margin-bottom: 8px;
    background-color: #2d2d2d;
    border-radius: 4px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #444444;
}

.git-commit-message-scroll-focus {
    border-color: #007acc;
}

.git-commit-message-field {
    background-color: transparent;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
    font-size: 12px;
    color: #cccccc;
    white-space: normal;
    min-height: 100%;
    flex-grow: 1;
}

.git-commit-message-field > TextInput,
.git-commit-message-field .unity-base-text-field__input {
    background-color: transparent;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    white-space: normal;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
}

.git-commit-char-count {
    font-size: 10px;
    color: #555555;
    -unity-text-align: middle-right;
    margin-bottom: 6px;
}

.git-commit-char-count-warn {
    color: #cca700;
}

.git-btn-commit {
    flex-grow: 1;
    height: 30px;
    background-color: #0e639c;
    color: #ffffff;
    -unity-font-style: bold;
    font-size: 12px;
    border-radius: 4px;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    cursor: link;
    overflow: hidden;
    white-space: nowrap;
    -unity-text-overflow-position: end;
}

.git-btn-commit:hover {
    background-color: #1177bb;
}

.git-btn-commit:disabled {
    background-color: #333333;
    color: #666666;
}

.git-btn-commit-push {
    flex-grow: 1;
    height: 30px;
    background-color: #2d2d2d;
    color: #cccccc;
    font-size: 12px;
    border-radius: 4px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #444444;
    margin-left: 6px;
    cursor: link;
    overflow: hidden;
    white-space: nowrap;
    -unity-text-overflow-position: end;
}

.git-btn-commit-push:hover {
    background-color: #3a3a3a;
    color: #ffffff;
    border-color: #666666;
}

/* ── Diff Viewer ──────────────────────────────────────────── */
.git-diff-panel {
    flex-direction: column;
    flex-grow: 1;
    height: 100%;
    overflow: hidden;
    background-color: #0d0d0d;
}

.git-diff-placeholder {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 20px;
    padding-bottom: 20px;
}

.git-diff-header {
    flex-direction: row;
    align-items: center;
    height: 36px;
    background-color: #1e1e1e;
    border-bottom-width: 1px;
    border-bottom-color: #333333;
    padding-left: 12px;
    padding-right: 10px;
}

.git-diff-file-name {
    -unity-font-style: bold;
    color: #e0e0e0;
    font-size: 12px;
    margin-right: 6px;
}

.git-diff-file-path {
    color: #666666;
    font-size: 11px;
    flex-grow: 1;
    -unity-text-overflow-position: end;
    overflow: hidden;
}

.git-diff-stats {
    flex-direction: row;
    align-items: center;
    margin-right: 8px;
}

.git-diff-stats-added {
    color: #28a745;
    font-size: 11px;
    -unity-font-style: bold;
    margin-right: 4px;
}

.git-diff-stats-deleted {
    color: #d73a49;
    font-size: 11px;
    -unity-font-style: bold;
}

.git-diff-open-btn {
    font-size: 10px;
    height: 22px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: #3a3a3a;
    color: #cccccc;
    border-radius: 3px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #555555;
    cursor: link;
}

.git-diff-open-btn:hover {
    background-color: #4a4a4a;
    color: #ffffff;
}

/* Diff content rows */
.git-diff-row {
    flex-direction: row;
    align-items: stretch;
    min-height: 19px;
}

.git-diff-row-added {
    background-color: rgba(40, 167, 69, 0.15);
}

.git-diff-row-deleted {
    background-color: rgba(215, 58, 73, 0.15);
}

.git-diff-row-hunk {
    background-color: rgba(0, 122, 204, 0.12);
}

.git-diff-row-meta {
    background-color: rgba(100, 100, 100, 0.1);
}

.git-diff-row-context {
    background-color: transparent;
}

/* Gutter (line numbers) */
.git-diff-gutter {
    flex-direction: row;
    align-items: center;
    min-width: 72px;
    width: 72px;
    background-color: #161616;
    border-right-width: 1px;
    border-right-color: #2a2a2a;
}

.git-diff-row-added .git-diff-gutter {
    background-color: rgba(40, 167, 69, 0.08);
}

.git-diff-row-deleted .git-diff-gutter {
    background-color: rgba(215, 58, 73, 0.08);
}

.git-diff-row-hunk .git-diff-gutter {
    background-color: rgba(0, 122, 204, 0.08);
}

.git-diff-line-num {
    width: 34px;
    -unity-text-align: middle-right;
    color: #454545;
    font-size: 10px;
    padding-right: 6px;
    -unity-font-style: normal;
}

.git-diff-line-num-active {
    color: #666666;
}

/* Diff change marker (+/-/ ) */
.git-diff-marker {
    width: 14px;
    min-width: 14px;
    -unity-text-align: middle-center;
    font-size: 12px;
    -unity-font-style: bold;
    padding-left: 0;
    padding-right: 0;
}

.git-diff-marker-added   { color: #28a745; }
.git-diff-marker-deleted { color: #d73a49; }
.git-diff-marker-context { color: transparent; }
.git-diff-marker-hunk    { color: #79b8ff; }
.git-diff-marker-meta    { color: #666666; }

/* Diff line content */
.git-diff-content {
    flex-grow: 1;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 11px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
}

.git-diff-content-added   { color: #85e89d; }
.git-diff-content-deleted { color: #f97583; }
.git-diff-content-context { color: #cccccc; }
.git-diff-content-hunk    { color: #79b8ff; -unity-font-style: bold; }
.git-diff-content-meta    { color: #888888; }

.git-diff-empty-msg {
    color: #555555;
    font-size: 13px;
    -unity-text-align: middle-center;
    flex-grow: 1;
    padding-top: 40px;
}

/* ── History / Commit List ────────────────────────────────── */
.git-commit-row {
    flex-direction: row;
    align-items: center;
    min-height: 54px;
    padding-left: 10px;
    padding-right: 12px;
    border-bottom-width: 1px;
    border-bottom-color: #282828;
    cursor: link;
}

.git-commit-row:hover {
    background-color: #2a2d2e;
}

.git-commit-row-selected {
    background-color: #094771;
}

.git-commit-row-selected:hover {
    background-color: #0a5280;
}

.git-commit-avatar {
    width: 30px;
    height: 30px;
    border-radius: 15px;
    margin-right: 10px;
    align-items: center;
    justify-content: center;
    min-width: 30px;
}

.git-commit-avatar-label {
    color: #ffffff;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.git-commit-text-col {
    flex-grow: 1;
    justify-content: center;
    overflow: hidden;
    margin-right: 8px;
}

.git-commit-message {
    font-size: 12px;
    color: #e0e0e0;
    -unity-text-overflow-position: end;
    overflow: hidden;
    white-space: nowrap;
}

.git-commit-meta {
    font-size: 10px;
    color: #888888;
    margin-top: 3px;
    white-space: nowrap;
    -unity-text-overflow-position: end;
    overflow: hidden;
}

.git-commit-hash-badge {
    font-size: 9px;
    color: #79b8ff;
    background-color: #192333;
    border-radius: 3px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 2px;
    padding-bottom: 2px;
    min-width: 44px;
    -unity-text-align: middle-center;
    -unity-font-style: normal;
}

/* Commit date group header */
.git-date-group-header {
    background-color: #252526;
    border-bottom-width: 1px;
    border-bottom-color: #333333;
    border-top-width: 1px;
    border-top-color: #333333;
    padding-left: 12px;
    padding-top: 5px;
    padding-bottom: 5px;
}

.git-date-group-label {
    font-size: 10px;
    color: #888888;
    -unity-font-style: bold;
}

/* Commit detail panel */
.git-commit-detail-panel {
    flex-direction: column;
    flex-grow: 1;
    background-color: #161616;
}

.git-commit-detail-header {
    background-color: #1e1e1e;
    border-bottom-width: 1px;
    border-bottom-color: #333333;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 12px;
    padding-bottom: 12px;
}

.git-commit-detail-hash {
    font-size: 11px;
    color: #79b8ff;
    margin-bottom: 4px;
    -unity-font-style: normal;
}

.git-commit-detail-author {
    font-size: 11px;
    color: #888888;
    margin-bottom: 6px;
}

.git-commit-detail-message {
    font-size: 14px;
    -unity-font-style: bold;
    color: #e0e0e0;
    white-space: normal;
}

.git-commit-detail-files-header {
    background-color: #252526;
    border-bottom-width: 1px;
    border-bottom-color: #333333;
    padding-left: 14px;
    padding-top: 6px;
    padding-bottom: 6px;
}

.git-commit-detail-files-label {
    font-size: 11px;
    color: #888888;
    -unity-font-style: bold;
}

.git-commit-file-row {
    flex-direction: row;
    align-items: center;
    height: 28px;
    padding-left: 14px;
    padding-right: 14px;
    border-bottom-width: 1px;
    border-bottom-color: #222222;
    cursor: link;
}

.git-commit-file-row:hover {
    background-color: #2a2d2e;
}

.git-commit-file-row-selected {
    background-color: #094771;
}

.git-commit-file-row-selected:hover {
    background-color: #0e5b8e;
}

.git-commit-file-label {
    font-size: 11px;
    color: #cccccc;
    flex-grow: 1;
}

/* ── Filter / Search Bar ──────────────────────────────────── */
.git-filter-bar {
    flex-direction: row;
    align-items: center;
    background-color: #252526;
    border-radius: 4px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #383838;
    padding-left: 8px;
    padding-right: 8px;
    height: 28px;
    margin-bottom: 10px;
}

.git-filter-field {
    flex-grow: 1;
    font-size: 11px;
    background-color: transparent;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    color: #cccccc;
    padding-left: 0;
    padding-right: 0;
}

/* ── Branch View ──────────────────────────────────────────── */
.git-branches-container {
    flex-grow: 1;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.git-new-branch-bar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
    background-color: #252526;
    border-radius: 6px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #383838;
    padding-left: 12px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.git-branches-section-label {
    font-size: 10px;
    -unity-font-style: bold;
    color: #666666;
    margin-bottom: 6px;
    margin-top: 8px;
    padding-left: 2px;
}

.git-branch-card {
    border-radius: 6px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #333333;
    background-color: #252526;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    margin-bottom: 6px;
}

.git-branch-card:hover {
    border-color: #555555;
    background-color: #2a2d2e;
}

.git-branch-card-current {
    border-color: #0e639c;
    background-color: #0d2a42;
}

.git-branch-card-current:hover {
    border-color: #1177bb;
    background-color: #0f3050;
}

.git-branch-card-header {
    flex-direction: row;
    align-items: center;
}

.git-branch-icon {
    font-size: 13px;
    margin-right: 8px;
    width: 18px;
    -unity-text-align: middle-center;
}

.git-branch-name {
    font-size: 12px;
    flex-grow: 1;
    -unity-text-overflow-position: end;
    overflow: hidden;
    white-space: nowrap;
}

.git-branch-name-current {
    color: #ffffff;
    -unity-font-style: bold;
}

.git-branch-name-default {
    color: #cccccc;
}

.git-branch-current-badge {
    font-size: 9px;
    color: #4ec9b0;
    background-color: #0d2e26;
    border-radius: 3px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 2px;
    padding-bottom: 2px;
    -unity-font-style: bold;
}

.git-branch-card-footer {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.git-branch-upstream-label {
    font-size: 10px;
    color: #555555;
    flex-grow: 1;
}

.git-btn-primary-small {
    font-size: 11px;
    height: 24px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: #0e639c;
    color: #ffffff;
    border-radius: 3px;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    margin-left: 4px;
    cursor: link;
}

.git-btn-primary-small:hover {
    background-color: #1177bb;
}

.git-btn-secondary-small {
    font-size: 11px;
    height: 24px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: #3a3a3a;
    color: #cccccc;
    border-radius: 3px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #555555;
    margin-left: 4px;
    cursor: link;
}

.git-btn-secondary-small:hover {
    background-color: #4a4a4a;
    color: #ffffff;
}

.git-btn-danger-small {
    font-size: 11px;
    height: 24px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: transparent;
    color: #888888;
    border-radius: 3px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #444444;
    margin-left: 4px;
    cursor: link;
}

.git-btn-danger-small:hover {
    background-color: #4a1a1a;
    color: #f97583;
    border-color: #8b0000;
}

/* ── Stash View ───────────────────────────────────────────── */
.git-stashes-container {
    flex-grow: 1;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.git-new-stash-bar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
    background-color: #252526;
    border-radius: 6px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #383838;
    padding-left: 12px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.git-stash-card {
    border-radius: 6px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #333333;
    background-color: #252526;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    margin-bottom: 8px;
}

.git-stash-card:hover {
    border-color: #555555;
    background-color: #2a2d2e;
}

.git-stash-card-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.git-stash-index-badge {
    font-size: 9px;
    color: #79b8ff;
    background-color: #192333;
    border-radius: 3px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-right: 8px;
    -unity-font-style: normal;
}

.git-stash-message {
    font-size: 12px;
    color: #e0e0e0;
    flex-grow: 1;
    white-space: normal;
}

.git-stash-time {
    font-size: 10px;
    color: #666666;
    margin-left: 6px;
    white-space: nowrap;
}

.git-stash-card-actions {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.git-stash-empty-label {
    color: #555555;
    font-size: 13px;
    -unity-text-align: middle-center;
    padding-top: 30px;
}

/* ── Toast Notifications ──────────────────────────────────── */
.git-toast-container {
    position: absolute;
    bottom: 14px;
    right: 14px;
    flex-direction: column;
    align-items: flex-end;
}

.git-toast {
    border-radius: 6px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 9px;
    padding-bottom: 9px;
    margin-top: 6px;
    font-size: 12px;
    color: #ffffff;
    min-width: 180px;
    max-width: 340px;
}

.git-toast-success {
    background-color: #1e6b3c;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #28a745;
}

.git-toast-error {
    background-color: #6b1e1e;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #d73a49;
}

.git-toast-info {
    background-color: #1a3a5c;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #0e639c;
}

/* ── Loading Overlay ──────────────────────────────────────── */
.git-loading-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    align-items: center;
    justify-content: center;
    display: none;
}

.git-loading-box {
    background-color: #2d2d2d;
    border-radius: 8px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #444444;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 16px;
    padding-bottom: 16px;
    align-items: center;
}

.git-loading-label {
    font-size: 13px;
    color: #cccccc;
    margin-top: 8px;
    -unity-text-align: middle-center;
}

/* ── No Repository UI ─────────────────────────────────────── */
.git-no-repo-container {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding-left: 24px;
    padding-right: 24px;
}

.git-no-repo-icon {
    width: 52px;
    height: 52px;
    margin-bottom: 14px;
}

.git-no-repo-title {
    font-size: 17px;
    -unity-font-style: bold;
    color: #e0e0e0;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.git-no-repo-subtitle {
    font-size: 12px;
    color: #888888;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 20px;
}

.git-btn-init-repo {
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: #0e639c;
    color: #ffffff;
    -unity-font-style: bold;
    font-size: 13px;
    border-radius: 5px;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    cursor: link;
}

.git-btn-init-repo:hover {
    background-color: #1177bb;
}

/* ── Error Banner ─────────────────────────────────────────── */
.git-error-banner {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: #6b1a1a;
    border-bottom-width: 1px;
    border-bottom-color: #d73a49;
    padding-left: 12px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
    display: none;
}

.git-error-label {
    color: #ffb3b3;
    font-size: 11px;
    white-space: normal;
    flex-grow: 1;
}

.git-error-close-btn {
    color: #ffb3b3;
    background-color: transparent;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    font-size: 13px;
    padding-left: 6px;
    padding-right: 2px;
    cursor: link;
}

.git-error-close-btn:hover {
    color: #ffffff;
}

/* ── Scrollview tweaks ────────────────────────────────────── */
.unity-scroll-view__content-container {
    flex-direction: column;
}
