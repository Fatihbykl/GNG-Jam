#terminal-container {
    flex-grow: 1;
    background-color: #0c0c0c;
    display: flex;
    flex-direction: column;
    padding: 0;
    margin: 0;
}

#tab-bar {
    flex-direction: row;
    height: 32px;
    background-color: #181822;
    border-bottom-width: 1px;
    border-bottom-color: #262636;
    align-items: flex-start;
    padding-left: 4px;
    padding-right: 4px;
    position: relative;
}

#tab-scroll {
    flex-grow: 1;
    height: 32px;
}

#tab-scroll .unity-scroll-view__content-container {
    flex-direction: row;
    height: 28px;
    align-items: flex-end;
}

#tab-scroll .unity-scroll-view__horizontal-scroller {
    height: 4px;
    margin: 0;
    padding: 0;
    background-color: #181822;
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
}

#tab-scroll .unity-scroller__slider {
    min-height: 4px;
    height: 4px;
    background-color: #3870bb;
    border-radius: 2px;
    margin: 0;
}

#tab-scroll .unity-scroller__high-button,
#tab-scroll .unity-scroller__low-button {
    display: none;
    width: 0;
    height: 0;
}

#btn-new-tab, #btn-clear-tab, #btn-restart-tab {
    width: 24px;
    height: 22px;
    font-size: 13px;
    -unity-font-style: bold;
    background-color: #222232;
    color: #a0a0c0;
    border-width: 0;
    border-radius: 4px;
    margin-left: 2px;
    margin-right: 2px;
    align-self: center;
    transition-duration: 0.15s;
}

#btn-new-tab:hover, #btn-clear-tab:hover, #btn-restart-tab:hover {
    background-color: #3870bb;
    color: #ffffff;
}

#btn-new-tab:active, #btn-clear-tab:active, #btn-restart-tab:active {
    background-color: #2a5590;
}

#btn-restart-tab:hover {
    background-color: #d32f2f;
    color: #ffffff;
}

#terminal-body {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    background-color: #0c0c0c;
    min-height: 0;
}

#terminal-viewport {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 4px 0 4px 6px;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
}

.terminal-grid {
    flex-grow: 1;
    background-color: #0c0c0c;
}

#terminal-scroller {
    width: 10px;
    min-width: 10px;
    margin: 0;
    background-color: #0c0c0c;
    border-width: 0;
}

#terminal-scroller .unity-scroller__low-button,
#terminal-scroller .unity-scroller__high-button {
    display: none;
}

#terminal-scroller .unity-base-slider__tracker {
    background-color: transparent;
    border-width: 0;
}

#terminal-scroller .unity-base-slider__dragger {
    background-color: #3a3a4c;
    border-width: 0;
    border-radius: 4px;
    left: 2px;
    width: 6px;
}

#terminal-scroller .unity-base-slider__dragger:hover {
    background-color: #55556c;
}

.terminal-tab {
    flex-direction: row;
    align-items: center;
    height: 24px;
    background-color: #1c1c28;
    margin-right: 3px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    padding-left: 8px;
    padding-right: 4px;
    transition-duration: 0.15s;
}

.terminal-tab:hover {
    background-color: #242436;
}

.terminal-tab.active {
    background-color: #0c0c0c;
    border-bottom-color: #3870bb;
}

.terminal-tab-btn {
    background-color: transparent;
    color: #c0c0d8;
    border-width: 0;
    font-size: 11px;
    padding: 0;
    margin: 0;
}

.terminal-tab.active .terminal-tab-btn {
    color: #ffffff;
    -unity-font-style: bold;
}

.terminal-tab-close {
    background-color: transparent;
    color: #8888a0;
    border-width: 0;
    font-size: 12px;
    margin-left: 6px;
    padding: 0 4px;
    border-radius: 3px;
}

.terminal-tab-close:hover {
    background-color: #d32f2f;
    color: #ffffff;
}

#terminal-status-bar {
    flex-direction: row;
    height: 20px;
    background-color: #14141c;
    border-top-width: 1px;
    border-top-color: #262636;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
}

#status-shell-info {
    color: #7f848e;
    font-size: 11px;
    padding: 0;
    margin: 0;
}

#status-spacer {
    flex-grow: 1;
}

#status-size-info {
    color: #7f848e;
    font-size: 11px;
    padding: 0;
    margin: 0;
}



